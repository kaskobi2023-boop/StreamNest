<Window x:Class="ChzzkDownloader.CancelDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다운로드 취소" Icon="Assets/streamnest.ico" Width="520" Height="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="다운로드를 취소할까요?" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                   Text="이번 작업의 임시 조각만 삭제하거나, 다음 다운로드에서 이어받도록 보관할 수 있습니다. 완성된 영상은 삭제하지 않습니다." />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="계속 다운로드" Style="{StaticResource SecondaryButton}" IsDefault="True" IsCancel="True" Click="ContinueButton_Click" />
            <Button Content="보관하고 취소" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="KeepButton_Click" />
            <Button Content="임시 조각 삭제 후 취소" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteButton_Click" />
        </StackPanel>
    </Grid>
</Window>
