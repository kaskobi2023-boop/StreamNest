<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>StreamNestDownloader</AssemblyName>
    <AssemblyTitle>StreamNest Downloader</AssemblyTitle>
    <RootNamespace>ChzzkDownloader</RootNamespace>
    <Product>StreamNest Downloader</Product>
    <Description>CHZZK와 YouTube 영상을 저장하는 Windows 다운로더</Description>
    <Version>0.6.6</Version>
    <ApplicationIcon>Assets\streamnest.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\streamnest.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Tools\yt-dlp.exe" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="Tools\ffmpeg.exe" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="Tools\ffprobe.exe" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="Tools\node.exe" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="Tools\yt-dlp-plugins\**\*"
             Exclude="Tools\yt-dlp-plugins\**\__pycache__\**;Tools\yt-dlp-plugins\**\*.pyc"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" CopyToPublishDirectory="Always" />
    <None Update="LICENSE" CopyToPublishDirectory="Never" />
    <None Update="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="Never" />
    <None Update="Licenses\**\*" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
