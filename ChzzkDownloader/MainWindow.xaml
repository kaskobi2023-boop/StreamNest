<Window x:Class="ChzzkDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamNest 다운로더" Icon="Assets/streamnest.ico" Width="979" Height="956"
        MinWidth="760" MinHeight="690" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="STREAMNEST" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="영상 다운로드" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DiagnosticsButton" Content="환경 점검 중…" Style="{StaticResource SecondaryButton}"
                        Padding="12,7" IsEnabled="False" AutomationProperties.Name="다운로드 환경 다시 점검"
                        Click="DiagnosticsButton_Click" />
                <Border Background="#10231A" BorderBrush="#245E3C" BorderThickness="1" CornerRadius="14" Padding="12,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Margin" Value="8,0,0,0" />
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="SessionStatusText" Text="공개 영상 모드" Foreground="#81E7AD" FontSize="12"
                               AutomationProperties.LiveSetting="Polite" />
                </Border>
                <Button x:Name="LogoutButton" Content="로그아웃" Style="{StaticResource SecondaryButton}"
                        Padding="14,7" Margin="8,0,0,0" Visibility="Collapsed"
                        AutomationProperties.Name="로그아웃" Click="LogoutButton_Click" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
                <TabControl x:Name="ModeTabs" SelectedIndex="0" SelectionChanged="ModeTabs_SelectionChanged"
                            AutomationProperties.Name="다운로드 종류" Background="Transparent" BorderThickness="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True" Background="Transparent" />
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabSurface" Background="#141E2A" CornerRadius="8" Padding="22,12" Margin="0,0,8,0"
                                                BorderThickness="1" BorderBrush="#2A394B">
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabSurface" Property="Background" Value="#253448" />
                                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="치지직 · YouTube" AutomationProperties.Name="치지직 · YouTube 탭" />
                    <TabItem Header="일반 영상" AutomationProperties.Name="일반 영상 탭" />
                </TabControl>
                <TextBlock x:Name="ModeDescriptionText" Text="기존 치지직·YouTube 다운로드와 로그인 기능을 사용합니다."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="WebRefererPathCheckBox" Visibility="Collapsed" Margin="0,10,0,0"
                          Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                          Content="HLS 호환 요청: 다른 영상 서버에 페이지 경로 전달 (쿼리·쿠키 제외)"
                          ToolTip="HLS 주소를 찾았지만 서버에서 거부할 때 선택 후 다시 분석하세요. 다른 서버에 Referer의 페이지 경로를 전달합니다. 주소의 쿼리와 로그인 쿠키는 전달하지 않습니다."
                          Checked="WebRefererPath_Changed" Unchecked="WebRefererPath_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                <Border Background="#102A20" BorderBrush="#245E3C" BorderThickness="1" CornerRadius="12" Padding="10,5"
                        ToolTip="치지직 영상 주소를 지원합니다.">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource ChzzkBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="CHZZK" Foreground="#81E7AD" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Background="#301A23" BorderBrush="#6F3042" BorderThickness="1" CornerRadius="12" Padding="10,5" Margin="8,0,0,0"
                        ToolTip="YouTube 영상 주소를 지원합니다.">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource YouTubeBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="YouTube" Foreground="#FF9DAB" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <TextBlock Text="두 플랫폼 · 하나의 저장 흐름" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="영상 주소" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="UrlKindText" Text="CHZZK / YouTube" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="9,1,0,0" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="UrlTextBox" FontSize="14" MinHeight="46" VerticalContentAlignment="Center"
                                 ToolTip="예: 치지직 https://chzzk.naver.com/video/14471813 또는 YouTube https://youtu.be/dQw4w9WgXcQ"
                                 AutomationProperties.Name="치지직 또는 YouTube 영상 주소"
                                 KeyDown="UrlTextBox_KeyDown" TextChanged="UrlTextBox_TextChanged" />
                        <TextBlock x:Name="UrlPlaceholderText" Text="치지직 또는 YouTube 영상 주소를 붙여넣으세요"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="13,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=UrlTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button x:Name="PasteButton" Grid.Column="1" Content="붙여넣기" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="PasteButton_Click" />
                    <Button x:Name="AnalyzeButton" Grid.Column="2" Content="영상 확인" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            IsEnabled="False" Click="AnalyzeButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="VideoCard" Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="208" Height="117" Background="#0A0F15" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left">
                    <Grid>
                        <Image x:Name="ThumbnailImage" Stretch="UniformToFill" />
                        <TextBlock x:Name="ThumbnailPlaceholder" Text="VIDEO" Foreground="#405367" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="18,3,16,3" VerticalAlignment="Center">
                    <StackPanel x:Name="WebVideoListPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="페이지에서 발견한 영상 (최대 20개)" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,6" />
                        <ComboBox x:Name="WebVideoComboBox" MinHeight="40" FontSize="13"
                                  AutomationProperties.Name="다운로드할 웹 영상 선택" SelectionChanged="WebVideoComboBox_SelectionChanged" />
                    </StackPanel>
                    <TextBlock x:Name="VideoTitleText" Text="주소를 입력하고 ‘영상 확인’을 눌러주세요." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="VideoMetaText" Text="공개 영상은 로그인 없이 바로 분석됩니다." Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,9,0,0" />
                    <Border x:Name="VideoStateBadge" Background="#1D2938" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <TextBlock x:Name="VideoStateText" Text="대기 중" Foreground="#B9C7D6" FontSize="12"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Border>
                </StackPanel>
                <Button x:Name="LoginButton" Grid.Column="2" Content="로그인하고 계속" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Visibility="Collapsed" Click="LoginButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Content="화질" Target="{Binding ElementName=QualityComboBox}" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0" />
                <ComboBox x:Name="QualityComboBox" Grid.Column="1" MinHeight="44" FontSize="15"
                          VerticalContentAlignment="Center" IsEnabled="False" AutomationProperties.Name="화질" />

                <Label Grid.Row="1" Content="저장 폴더" Target="{Binding ElementName=OutputFolderTextBox}" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,14,0,0" Padding="0" />
                <TextBox x:Name="OutputFolderTextBox" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" MinHeight="44"
                         FontSize="15" VerticalContentAlignment="Center" IsReadOnly="True" AutomationProperties.Name="저장 폴더" />
                <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="2" Content="찾아보기" Style="{StaticResource SecondaryButton}"
                        FontSize="14" Margin="10,14,0,0" Click="BrowseButton_Click" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,18,16,0">
                    <ProgressBar x:Name="DownloadProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource PrimaryBrush}" Background="#253143" AutomationProperties.Name="다운로드 진행률" />
                    <TextBlock x:Name="ProgressText" Text="다운로드 준비가 되면 시작 버튼이 활성화됩니다."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="OpenFolderButton" Content="저장 폴더 열기" Style="{StaticResource SecondaryButton}"
                            FontSize="14" ToolTip="현재 지정된 저장 폴더를 엽니다."
                            AutomationProperties.Name="현재 지정된 저장 폴더 열기" Click="OpenFolderButton_Click" />
                    <Button x:Name="CancelButton" Content="취소" Style="{StaticResource DangerButton}" Margin="8,0,0,0" IsEnabled="False" Click="CancelButton_Click" />
                    <Button x:Name="DownloadButton" Content="다운로드" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="DownloadButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Expander x:Name="LogExpander" Grid.Row="4" Header="상세 작업 기록" IsExpanded="False"
                  Foreground="{StaticResource MutedTextBrush}" AutomationProperties.Name="상세 작업 기록">
            <Border Background="#0D141D" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Content="기록 복사" Style="{StaticResource SecondaryButton}" Padding="12,6"
                            HorizontalAlignment="Right" AutomationProperties.Name="작업 기록 복사" Click="CopyLogButton_Click" />
                    <TextBox x:Name="LogTextBox" Grid.Row="1" Height="150" Margin="0,8,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11" AutomationProperties.Name="작업 기록 내용" />
                </Grid>
            </Border>
        </Expander>
    </Grid>
    </ScrollViewer>
    </Grid>
</Window>
